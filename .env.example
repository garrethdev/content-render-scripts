# Copy to .env (git-ignored) OR keep these in ~/.config/peptide-secrets/.env.
# common/env.py loads both automatically. NEVER commit real values.

# --- Supabase (project qlcmgxgwpzmiebzxflai) ---
SUPABASE_URL=https://qlcmgxgwpzmiebzxflai.supabase.co
# Anon / publishable key (client-safe, read-mostly). Used by the pull/notify helpers
# and the conspiracy renderer's read path.
SUPABASE_ANON_KEY=
# Service-role key (bypasses RLS, writes storage). The main renderers need this.
# NOTE: two var names are in use across scripts — set BOTH to the same service key:
CAROUSEL_SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- other services ---
OPENROUTER_KEY=
SCRAPECREATORS_KEY=
N8N_BASE=https://czed.app.n8n.cloud

# --- tooling (override if not on PATH) ---
FFMPEG=ffmpeg
FFPROBE=ffprobe
HOOK_FONT_OTF=
EMOJI_FONT=/System/Library/Fonts/Apple Color Emoji.ttc

# --- asset locations (defaults point at this machine; override when relocating) ---
CONSPIRACY_SEGDIR=
CONSPIRACY_OUTDIR=
DIVORCE_OUT_DIR=
